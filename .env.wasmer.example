# Use this on the Wasmer server (fill in your own database values).
# Set CI_ENVIRONMENT = development only while debugging, then back to production.
CI_ENVIRONMENT = production

app.baseURL = 'https://todo-app.wasmer.app/'
app.indexPage = ''

database.default.hostname = YOUR_DB_HOST
database.default.database = YOUR_DB_NAME
database.default.username = YOUR_DB_USER
database.default.password = YOUR_NEW_DB_PASSWORD
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = YOUR_DB_PORT
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_general_ci
